{
  "expo": {
    "name": "MuvU",
    "slug": "muvu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "muvumobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.muvumobile"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MuvU usa tu ubicación para encontrar universidades cercanas y ubicar tu habitación en el mapa."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MuvU usa la cámara para tomar la foto de tu DNI y de tus habitaciones.",
          "photosPermission": "MuvU usa tus fotos para elegir la foto de tu DNI o de tus habitaciones.",
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Stripe: push provisioning (Google Wallet / Issuing) no se usa en MuvU y sus clases no vienen en el SDK\n-dontwarn com.stripe.android.pushProvisioning.**",
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a800aaa6-6ca9-4845-af40-7b35e9c03f94"
      }
    },
    "owner": "lucasmcgamer",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a800aaa6-6ca9-4845-af40-7b35e9c03f94"
    }
  }
}
