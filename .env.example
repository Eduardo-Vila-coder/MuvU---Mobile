# Base URL including the backend API version. Use your computer's LAN IP on a physical device.
# Android emulator: http://10.0.2.2:8080/api/v1
# iOS simulator: http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api/v1
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Keep true for Stripe test mode; set false for production.
EXPO_PUBLIC_STRIPE_TEST_MODE=true

# Google Maps: Maps JavaScript API, Places API (New), Geocoding API and Routes API.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# HTTPS base origin for the native WebView; authorize it in the Maps key referrers.
# On web, authorize the actual app origin instead (including localhost and port).
EXPO_PUBLIC_GOOGLE_MAPS_BASE_URL=https://localhost/
